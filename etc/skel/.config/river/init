#!/bin/sh

# Teclado, mouse/touchpad, cursor, bordas e cores: ficam no voidbr-river-apply,
# que lê os ajustes do VoidBR River Tweaks (~/.config/river/voidbr-tweaks.sh)
/usr/local/bin/voidbr-river-apply river

# Super + botões do mouse: mover / redimensionar / alternar float
riverctl map-pointer normal Super BTN_LEFT   move-view
riverctl map-pointer normal Super BTN_RIGHT  resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# ---------------------------------------------------------------------------
# Atalhos
# ---------------------------------------------------------------------------
# Terminal (XFCE Terminal)
riverctl map normal Super Return spawn xfce4-terminal

# Close focused window
riverctl map normal Super Q close

# Menu de energia (sair, suspender, reiniciar, desligar)
riverctl map normal Super+Shift E spawn 'pkill -x wlogout || wlogout -b 5'

# Bloquear a tela
riverctl map normal Super L spawn /usr/local/bin/voidbr-river-lock

# Ajustes do River (VoidBR River Tweaks)
riverctl map normal Super F1 spawn voidbr-river-tweaks

# App launcher
riverctl map normal Super D spawn fuzzel

# File manager
riverctl map normal Super E spawn thunar

# Central de notificações
riverctl map normal Super N spawn 'swaync-client -t -sw'

# Navegação entre janelas
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous

# Tamanho da área principal do rivertile
riverctl map normal Super+Alt H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super+Alt L send-layout-cmd rivertile "main-ratio +0.05"

# Float / fullscreen
riverctl map normal Super Space toggle-float
riverctl map normal Super F toggle-fullscreen

# Tags (workspaces) 1-9
for i in $(seq 1 9); do
	tags=$((1 << (i - 1)))
	riverctl map normal Super "$i" set-focused-tags "$tags"
	riverctl map normal Super+Shift "$i" set-view-tags "$tags"
done

# Teclas de mídia (funcionam também com a tela bloqueada)
for mode in normal locked; do
	riverctl map $mode None XF86AudioRaiseVolume  spawn '/usr/local/bin/voidbr-river-osd volume +'
	riverctl map $mode None XF86AudioLowerVolume  spawn '/usr/local/bin/voidbr-river-osd volume -'
	riverctl map $mode None XF86AudioMute         spawn '/usr/local/bin/voidbr-river-osd volume mudo'
	riverctl map $mode None XF86MonBrightnessUp   spawn '/usr/local/bin/voidbr-river-osd brilho +'
	riverctl map $mode None XF86MonBrightnessDown spawn '/usr/local/bin/voidbr-river-osd brilho -'
	riverctl map $mode None XF86AudioPlay  spawn 'playerctl play-pause'
	riverctl map $mode None XF86AudioPause spawn 'playerctl play-pause'
	riverctl map $mode None XF86AudioNext  spawn 'playerctl next'
	riverctl map $mode None XF86AudioPrev  spawn 'playerctl previous'
done

# ---------------------------------------------------------------------------
# Regras de janelas
# ---------------------------------------------------------------------------
# Diálogos e janelas pequenas abrem flutuando
riverctl rule-add -app-id 'pavucontrol' float
riverctl rule-add -app-id 'nm-connection-editor' float
riverctl rule-add -app-id 'blueman-manager' float
riverctl rule-add -title 'Picture-in-Picture' float

# ---------------------------------------------------------------------------
# Sessão e layout
# ---------------------------------------------------------------------------
# Papel de parede, barra, notificações, OSD, inatividade, bandeja
/usr/local/bin/voidbr-river-session &

# Gerador de layout: sem ele o River não arranja as janelas
# (espaço entre janelas e área principal vêm do VoidBR River Tweaks)
riverctl default-layout rivertile
# shellcheck disable=SC2046
exec rivertile $(/usr/local/bin/voidbr-river-apply args)
