{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin": "4 8 0 8",
  "spacing": 4,
  "modules-left": [
    "custom/menu",
    "river/tags",
    "river/mode",
    "river/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "wireplumber",
    "network",
    "cpu",
    "memory",
    "battery",
    "tray",
    "custom/power"
  ],
  // Menu de aplicativos (fuzzel)
  "custom/menu": {
    "format": "  VoidBR",
    "tooltip": true,
    "tooltip-format": "Menu de Aplicativos (Super + D)",
    "on-click": "pkill -x fuzzel || fuzzel"
  },
  // Tags do River: clique = ir para a tag | clique-direito = mostrar junto
  "river/tags": {
    "num-tags": 9,
    "hide-vacant": true
  },
  "river/mode": {
    "format": "󰌌 {}"
  },
  "river/window": {
    "format": "{}",
    "max-length": 50
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "max-length": 30,
    "player-icons": {
      "default": "󰎆",
      "firefox": "󰈹",
      "spotify": "󰓇",
      "mpv": "󰐹"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{artist} - {title}\nClique: tocar/pausar | Scroll: faixa",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  // Volume do PipeWire
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "{node_name}\nClique: mixer | Direito: mudo | Scroll: volume",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nClique: conexões de rede",
    "on-click": "nm-connection-editor"
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "on-click": "xfce4-terminal -e htop"
  },
  "memory": {
    "format": "󰍛 {}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "xfce4-terminal -e htop"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "warning": 25, "critical": 10 }
  },
  "clock": {
    "format": " {:%H:%M   %d/%m/%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "locale": "pt_BR.UTF-8"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  // Sair / Suspender / Reiniciar / Desligar (fuzzel em modo dmenu + elogind)
  "custom/power": {
    "format": " 󰐥 ",
    "tooltip": true,
    "tooltip-format": "Sair / Suspender / Reiniciar / Desligar",
    "on-click": "pkill -x fuzzel || case $(printf '󰍃 Sair\\n󰒲 Suspender\\n󰜉 Reiniciar\\n󰐥 Desligar' | fuzzel --dmenu --lines 4 --prompt 'Energia: ') in *Sair) riverctl exit ;; *Suspender) loginctl suspend ;; *Reiniciar) loginctl reboot ;; *Desligar) loginctl poweroff ;; esac"
  }
}
