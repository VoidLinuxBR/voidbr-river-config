{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin": "4 8 0 8",
  "spacing": 4,
  "modules-left": [
    "custom/menu",
    "river/tags",
    "river/mode",
    "river/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "wireplumber",
    "network",
    "cpu",
    "memory",
    "backlight",
    "battery",
    "group/indicators",
    "tray",
    "custom/notification",
    "custom/power"
  ],
  // Menu de aplicativos (fuzzel)
  "custom/menu": {
    "format": "  VoidBR",
    "tooltip": true,
    "tooltip-format": "Clique: aplicativos (Super + D)\nDireito: VoidBR River Tweaks (Super + F1)",
    "on-click": "pkill -x fuzzel || fuzzel",
    "on-click-right": "voidbr-river-tweaks"
  },
  // Tags do River: clique = ir para a tag | clique-direito = mostrar junto
  "river/tags": {
    "num-tags": 9,
    "hide-vacant": true
  },
  "river/mode": {
    "format": "󰌌 {}"
  },
  "river/window": {
    "format": "{}",
    "max-length": 50
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "max-length": 30,
    "player-icons": {
      "default": "󰎆",
      "firefox": "󰈹",
      "spotify": "󰓇",
      "mpv": "󰐹"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{artist} - {title}\nClique: tocar/pausar | Scroll: faixa",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  // Volume do PipeWire
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "{node_name}\nClique: mixer | Direito: mudo | Scroll: volume",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nClique: conexões de rede",
    "on-click": "nm-connection-editor"
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "on-click": "xfce4-terminal -e htop"
  },
  "memory": {
    "format": "󰍛 {}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "xfce4-terminal -e htop"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "warning": 25, "critical": 10 }
  },
  "clock": {
    "format": " {:%H:%M   %d/%m/%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "locale": "pt_BR.UTF-8"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brilho da tela\nScroll: ajustar",
    "on-scroll-up": "/usr/local/bin/voidbr-river-osd brilho +",
    "on-scroll-down": "/usr/local/bin/voidbr-river-osd brilho -"
  },
  "group/indicators": {
    "orientation": "inherit",
    "modules": ["custom/nightlight", "idle_inhibitor"]
  },
  // Luz noturna (wlsunset)
  "custom/nightlight": {
    "exec": "/usr/local/bin/voidbr-river-nightlight",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "/usr/local/bin/voidbr-river-nightlight toggle"
  },
  // "Café": impede o swayidle de bloquear/apagar a tela
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Manter acordado: ATIVADO",
    "tooltip-format-deactivated": "Manter acordado: desligado"
  },
  // Central de notificações (swaync): clique abre o painel, direito = não perturbe
  "custom/notification": {
    "tooltip": true,
    "tooltip-format": "Notificações (Super + N)\nDireito: não perturbe",
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  // Menu de energia em tela cheia (wlogout) - Super + Shift + E
  "custom/power": {
    "format": " 󰐥 ",
    "tooltip": true,
    "tooltip-format": "Bloquear / Sair / Suspender / Reiniciar / Desligar (Super + Shift + E)",
    "on-click": "pkill -x wlogout || wlogout -b 5"
  }
}
