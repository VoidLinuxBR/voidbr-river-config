        self.op_papel = papeis()
        self.w_papel = self._lista(g, "Imagem", self.op_papel,
                                   f"Imagens de {PAPEL_PASTA} (voidbr-wallpapers).")
        botao = Gtk.Button(label="📂 Escolher outra imagem…", halign=Gtk.Align.START)
        botao.connect("clicked", self.ao_escolher_imagem)
        g.attach(botao, 0, g._linha, 3, 1)
        g._linha += 1
        self.w_papel_modo = self._lista(g, "Modo", list(MODOS_PAPEL))
        self.w_papel_bloqueio = self._chave(g, "Usar também na tela de bloqueio",
                                            "Desligado: a tela de bloqueio fica só com a cor de "
                                            "fundo.")
        return g

    def _aba_teclado(self):
        g = self._grade("Teclado")
        self.w_teclado = self._lista(g, "Layout", list(TECLADOS))
        self.w_rep_atraso = self._escala(g, "Atraso para repetir a tecla", 150, 800, 50, " ms")
        self.w_rep_taxa = self._escala(g, "Velocidade da repetição", 10, 80, 5, "/s")
        self._secao(g, "Mouse e touchpad")
        self.w_toque = self._chave(g, "Tocar para clicar", "Só para touchpads.")
        self.w_rolagem = self._chave(g, "Rolagem natural", "Rolagem invertida, como no celular.")
        self.w_velocidade = self._escala(g, "Velocidade do ponteiro", -100, 100, 10, "",
                                         "0 é o normal do libinput.")
        self._secao(g, "Atalhos (do ~/.config/river/init)")
        self.g_atalhos = g
        self.l_atalhos = []
        return g

    def _aba_energia(self):
        g = self._grade("Inatividade")
        self.w_bloquear = self._lista(g, "Bloquear a tela depois de", list(TEMPOS_BLOQUEIO),
                                      "A tela bloqueia também antes de suspender e por Super+L.")
        self.w_apagar = self._lista(g, "Apagar a tela depois de", list(TEMPOS_TELA))
        self._aviso(g, "O botão ☕ (manter acordado) da barra pausa os dois enquanto estiver "
                       "ligado.")
        return g

    def _mostrar_atalhos(self, atalhos):
        g = self.g_atalhos
        for w in self.l_atalhos:
            g.remove(w)
        self.l_atalhos = []
        linha = g._linha
        for tecla, descr in atalhos:
            t = Gtk.Label(label=tecla, xalign=0)
            t.add_css_class("atalho")
            d = Gtk.Label(label=descr, xalign=0, hexpand=True, wrap=True)
            g.attach(t, 0, linha, 1, 1)
            g.attach(d, 1, linha, 2, 1)
            self.l_atalhos += [t, d]
            linha += 1
        nota = Gtk.Label(label="Para mudar atalhos: menu ☰ → Editar o init do River. Valem no "
                               "próximo login.", xalign=0, wrap=True)
        nota.add_css_class("dica")
        g.attach(nota, 0, linha, 3, 1)
        self.l_atalhos.append(nota)

    # ----- valores <-> interface -----

    def mostrar(self, v):
        _escolha(self.w_barra_estilo, self.w_barra_estilo._opcoes, v["barra_estilo"])
        _escolha(self.w_barra_posicao, self.w_barra_posicao._opcoes, v["barra_posicao"])
        self.w_barra_altura.set_value(v["barra_altura"])
        for m, sw in self.w_mod.items():
            sw.set_active(v["modulos"].get(m, True))
        _escolha(self.w_gtk, self.op_gtk, v["gtk_tema"])
        _escolha(self.w_icones, self.op_icones, v["icones"])
        _escolha(self.w_cursor, self.op_cursor, v["cursor"])
        self.w_cursor_tam.set_value(v["cursor_tamanho"])
        _escolha(self.w_destaque, self.w_destaque._opcoes, v["destaque"])
        self.w_borda.set_value(v["borda"])
        _escolha(self.w_area_lugar, self.w_area_lugar._opcoes, v["area_lugar"])
        self.w_area_prop.set_value(v["area_proporcao"])
        self.w_espaco.set_value(v["espaco"])
        _escolha(self.w_foco, self.w_foco._opcoes, v["foco"])
        _escolha(self.w_novas, self.w_novas._opcoes, v["novas"])
        _escolha(self.w_papel, self.op_papel, v["papel"])
        _escolha(self.w_papel_modo, self.w_papel_modo._opcoes, v["papel_modo"])
        self.w_papel_bloqueio.set_active(v["papel_bloqueio"])
        _escolha(self.w_teclado, self.w_teclado._opcoes, v["teclado"])
        self.w_rep_atraso.set_value(v["repeticao_atraso"])
        self.w_rep_taxa.set_value(v["repeticao_taxa"])
        self.w_toque.set_active(v["toque"])
        self.w_rolagem.set_active(v["rolagem_natural"])
        self.w_velocidade.set_value(v["velocidade"])
        _escolha(self.w_bloquear, self.w_bloquear._opcoes, v["bloquear_min"])
        _escolha(self.w_apagar, self.w_apagar._opcoes, v["apagar_min"])
        self._mostrar_atalhos(atalhos_do_init())

    def coletar(self):
        a = self.antes
        return {
            "barra_posicao": self._valor_dd(self.w_barra_posicao),
            "barra_altura": int(self.w_barra_altura.get_value()),
            "barra_estilo": self._valor_dd(self.w_barra_estilo),
            "modulos": {m: sw.get_active() for m, sw in self.w_mod.items()},
            "gtk_tema": self._valor_dd(self.w_gtk) or a["gtk_tema"],
            "icones": self._valor_dd(self.w_icones) or a["icones"],
            "cursor": self._valor_dd(self.w_cursor) or a["cursor"],
            "cursor_tamanho": int(self.w_cursor_tam.get_value()),
            "destaque": self._valor_dd(self.w_destaque),
            "borda": int(self.w_borda.get_value()),
            "espaco": int(self.w_espaco.get_value()),
            "area_lugar": self._valor_dd(self.w_area_lugar),
            "area_proporcao": int(self.w_area_prop.get_value()),
            "foco": self._valor_dd(self.w_foco),
            "novas": self._valor_dd(self.w_novas),
            "papel": self._valor_dd(self.w_papel) or a["papel"],
            "papel_modo": self._valor_dd(self.w_papel_modo),
            "papel_bloqueio": self.w_papel_bloqueio.get_active(),
            "teclado": self._valor_dd(self.w_teclado),
            "repeticao_taxa": int(self.w_rep_taxa.get_value()),
            "repeticao_atraso": int(self.w_rep_atraso.get_value()),
            "toque": self.w_toque.get_active(),
            "rolagem_natural": self.w_rolagem.get_active(),
            "velocidade": int(self.w_velocidade.get_value()),
            "bloquear_min": self._valor_dd(self.w_bloquear),
            "apagar_min": self._valor_dd(self.w_apagar),
        }

    def recarregar(self):
        self.antes = valores_atuais()
        self.mostrar(self.antes)
        self.status("✔ Pronto." if river_rodando() else
                    "✔ Pronto — o River não está rodando: as mudanças valem no próximo login.")

    def status(self, texto):
        self.label_status.set_text(texto)
        return False

    # ----- botões -----

    def ao_clicar_aplicar(self, *_):
        v = self.coletar()
        self.b_aplicar.set_sensitive(False)

        def tarefa():
            try:
                feito = aplicar(v, self.antes, lambda t: GLib.idle_add(self.status, t))
                GLib.idle_add(self._fim, feito, v, None)
            except Exception as erro:  # noqa: BLE001 - mostra qualquer falha ao usuário
                GLib.idle_add(self._fim, [], v, str(erro))
        threading.Thread(target=tarefa, daemon=True).start()

    def _fim(self, feito, v, erro):
        self.b_aplicar.set_sensitive(True)
        if erro:
            self.status(f"⚠️ {erro}")
        elif not feito:
            self.status("ℹ️ Nada mudou.")
        else:
            self.antes = v
            quando = "" if river_rodando() else " Vale no próximo login."
            self.status("✅ Aplicado: " + ", ".join(feito) + "." + quando)
        return False

    def confirmar_restaurar(self, base):
        if base == "voidbr":
            msg = "Restaurar o padrão VoidBR?"
            detalhe = ("Barra, atalhos, cores, papel de parede, tela de bloqueio e menus voltam "
                       "ao padrão do VoidBR, e na hora. Os arquivos atuais ficam guardados em "
                       "~/.voidbr-skel-backup-<data>.")
        else:
            msg = "Voltar ao River original?"
            detalhe = ("O init vira o exemplo do pacote river: sem barra, sem papel de parede, "
                       "sem bloqueio de tela e com os atalhos originais (Super+Shift+Enter abre "
                       "o terminal). Vale no próximo login. Para voltar, rode "
                       "voidbr-river-tweaks --padrao-voidbr no terminal. Os arquivos atuais "
                       "ficam guardados em ~/.voidbr-skel-backup-<data>.")
        dlg = Gtk.AlertDialog(message=msg, detail=detalhe, buttons=["Cancelar", "Restaurar"],
                              cancel_button=0, default_button=1)
        dlg.choose(self, None, self._resposta_restaurar, base)

    def _resposta_restaurar(self, dlg, res, base):
        try:
            if dlg.choose_finish(res) != 1:
                return
        except GLib.Error:
            return
        for b in (self.b_aplicar, *self.b_restaurar):
            b.set_sensitive(False)

        def tarefa():
            try:
                pasta, agora = restaurar(base, lambda t: GLib.idle_add(self.status, t))
                GLib.idle_add(self._fim_restaurar, base, pasta, agora, None)
            except Exception as erro:  # noqa: BLE001 - mostra qualquer falha ao usuário
                GLib.idle_add(self._fim_restaurar, base, None, False, str(erro))
        threading.Thread(target=tarefa, daemon=True).start()

    def _fim_restaurar(self, base, pasta, agora, erro):
        for b in (self.b_aplicar, *self.b_restaurar):
            b.set_sensitive(True)
        if erro:
            self.status(f"⚠️ {erro}")
            return False
        nome = "VoidBR" if base == "voidbr" else "River original"
        self.recarregar()
        self.status(f"✅ Padrão {nome} restaurado" + (" e aplicado." if agora else
                                                      "; vale no próximo login.") +
                    f" Backup em {pasta}.")
        return False

    def ao_escolher_imagem(self, *_):
        dlg = Gtk.FileDialog(title="Imagem do papel de parede", modal=True)
        filtro = Gtk.FileFilter()
        filtro.set_name("Imagens")
        for ext in PAPEL_EXT:
            filtro.add_pattern("*" + ext)
            filtro.add_pattern("*" + ext.upper())
        filtros = Gio.ListStore.new(Gtk.FileFilter)
        filtros.append(filtro)
        dlg.set_filters(filtros)
        if os.path.isdir(PAPEL_PASTA):
            dlg.set_initial_folder(Gio.File.new_for_path(PAPEL_PASTA))

        def fim(d, res):
            try:
                arq = d.open_finish(res)
            except GLib.Error:
                return
            caminho = arq.get_path()
            if caminho:
                _escolha(self.w_papel, self.op_papel, caminho)
        dlg.open(self, None, fim)

    def ao_editar_init(self, *_):
        try:
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(RIVER_INIT).get_uri(), None)
            self.status("ℹ️ Init aberto no editor. Os atalhos novos valem no próximo login.")
        except GLib.Error as erro:
            self.status(f"⚠️ Não consegui abrir o editor: {erro.message}")

    # ----- fonte do app -----

    def aplicar_fonte(self):
        nome = Gtk.Settings.get_default().props.gtk_font_name or ""
        m = re.search(r"(\d+(?:\.\d+)?)\s*$", nome)
        base = float(m.group(1)) if m else 11.0
        s = self.escala_fonte
        self.css_fonte.load_from_data((
            f"window, window * {{ font-size: {base * s:.1f}pt; }}\n"
            f".titulo-app {{ font-size: {20 * s:.0f}px; }}\n"
            f".subtitulo {{ font-size: {12 * s:.0f}px; }}\n"
            f".dica {{ font-size: {11 * s:.0f}px; }}\n").encode("utf-8"))
        for w in Gtk.Window.list_toplevels():
            w.queue_resize()
        self.b_escala.set_label(f"{round(s * 100)}%")
        self.b_menor.set_sensitive(s > ESCALA_MIN + 0.001)
        self.b_maior.set_sensitive(s < ESCALA_MAX - 0.001)

    def mudar_fonte(self, passo):
        nova = 1.0 if passo == 0 else round(self.escala_fonte + 0.1 * passo, 2)
        nova = min(ESCALA_MAX, max(ESCALA_MIN, nova))
        if nova == self.escala_fonte and passo:
            return
        self.escala_fonte = nova
        self.aplicar_fonte()
        try:
            gravar_prefs_app(font_scale=nova)
        except OSError:
            pass

    def ao_clicar_sobre(self, *_):
        sobre = Gtk.AboutDialog(transient_for=self, modal=True)
        sobre.set_program_name("VoidBR River Tweaks")
        sobre.set_version(VERSAO)
        sobre.set_comments("Ajustes do River do VoidBR:\nbarra, aparência, janelas, papel de "
                           "parede,\nteclado, mouse e energia.")
        sobre.set_authors(["Vilmar Catafesta <vcatafesta@gmail.com>"])
        sobre.set_copyright("© 2026 Vilmar Catafesta")
        sobre.set_website("https://voidbr.org")
        sobre.set_website_label("voidbr.org")
        sobre.set_license_type(Gtk.License.BSD)
        sobre.set_logo_icon_name(APP_ID)
        sobre.present()


class AppTweaks(Gtk.Application):
    def __init__(self, aba=None):
        super().__init__(application_id=APP_ID,
                         flags=getattr(Gio.ApplicationFlags, "DEFAULT_FLAGS",
                                       Gio.ApplicationFlags.FLAGS_NONE))
        self.aba = aba

    def do_activate(self):
        janela = self.props.active_window or JanelaTweaks(self, self.aba)
        janela.present()


def main():
    args = sys.argv[1:]
    if "--version" in args:
        print(f"voidbr-river-tweaks {VERSAO}")
        return 0
    if "--help" in args or "-h" in args:
        print("Uso: voidbr-river-tweaks [--aba barra|aparencia|janelas|papel|teclado|energia]\n"
              "                           [--padrao-voidbr | --padrao-river]")
        return 0
    if "--padrao-voidbr" in args or "--padrao-river" in args:
        base = "voidbr" if "--padrao-voidbr" in args else "river"
        pasta, agora = restaurar(base, print)
        print(f"Padrão {base} restaurado. Backup em {pasta}" +
              ("" if agora else " (vale no próximo login)"))
        return 0
    aba = None
    if "--aba" in args:
        i = args.index("--aba")
        aba = args[i + 1] if i + 1 < len(args) else None
    return AppTweaks(aba).run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
