MARCA_INI = "/* voidbr-river-tweaks: inicio (gerado pelo app, não edite entre as marcas) */"
MARCA_FIM = "/* voidbr-river-tweaks: fim */"


# ---------------------------------------------------------------------------
#   preferências do próprio app (valores e fonte)
# ---------------------------------------------------------------------------

def ler_prefs_app():
    try:
        with open(PREFS_APP, encoding="utf-8") as f:
            dados = json.load(f)
        return dados if isinstance(dados, dict) else {}
    except (OSError, ValueError):
        return {}


def gravar_prefs_app(**valores):
    dados = ler_prefs_app()
    dados.update(valores)
    os.makedirs(os.path.dirname(PREFS_APP), exist_ok=True)
    with open(PREFS_APP, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=2, ensure_ascii=False)
        f.write("\n")


def _ler(caminho):
    try:
        with open(caminho, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def _gravar(caminho, texto):
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    tmp = caminho + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(texto)
    os.replace(tmp, caminho)


# ---------------------------------------------------------------------------
#   Waybar (config em JSONC: altera só os campos do app, mantém os comentários)
# ---------------------------------------------------------------------------

def _jsonc(texto):
    """Lê o JSONC da Waybar (tira os comentários // de linha inteira)."""
    return json.loads(re.sub(r"^\s*//.*$", "", texto, flags=re.M))


def waybar_ler():
    txt = _ler(WAYBAR_CFG)
    if txt is None:
        return {}
    try:
        cfg = _jsonc(txt)
    except ValueError:
        return {}
    direita = cfg.get("modules-right", [])
    margem = str(cfg.get("margin", ""))
    v = {
        "barra_posicao": cfg.get("position", "top"),
        "barra_altura": int(cfg.get("height", 38) or 38),
        "barra_estilo": "colada" if margem.strip() in ("", "0") else "ilha",
        "modulos": {chave: all(m in direita for m in mods) for chave, mods, _t, _d in MODULOS_BARRA},
    }
    return v


def _trocar(txt, chave, valor_json):
    """Troca o valor de "chave" no nível de cima do config (string, número ou lista)."""
    padrao = re.compile(r'("%s"\s*:\s*)(\[[^\]]*\]|"[^"]*"|-?\d+)' % re.escape(chave))
    if padrao.search(txt):
        return padrao.sub(lambda m: m.group(1) + valor_json, txt, count=1)
    # chave ausente: entra logo depois da primeira chave "{"
    return txt.replace("{", "{\n  \"%s\": %s," % (chave, valor_json), 1)


def waybar_gravar(v):
    txt = _ler(WAYBAR_CFG)
    if txt is None:
        raise RuntimeError(f"{WAYBAR_CFG} não encontrado: use o Padrão VoidBR para recriar.")
    direita = []
    for chave, mods, _t, _d in MODULOS_BARRA:
        if v["modulos"].get(chave, True):
            direita += mods
    direita += MODULOS_FIXOS
    lista = "[\n" + ",\n".join(f'    "{m}"' for m in direita) + "\n  ]"
    txt = _trocar(txt, "position", json.dumps(v["barra_posicao"]))
    txt = _trocar(txt, "height", str(int(v["barra_altura"])))
    if v["barra_estilo"] == "ilha":
        margem = "4 8 0 8" if v["barra_posicao"] == "top" else "0 8 4 8"
    else:
        margem = "0"
    txt = _trocar(txt, "margin", json.dumps(margem))
    txt = _trocar(txt, "modules-right", lista)
    _jsonc(txt)  # não grava um config quebrado
    _gravar(WAYBAR_CFG, txt)

    # estilo: bloco entre marcas no fim do style.css (vence o que vem antes)
    css = _ler(WAYBAR_CSS) or ""
    css = re.sub(r"\n?" + re.escape(MARCA_INI) + r".*?" + re.escape(MARCA_FIM) + r"\n?", "\n",
                 css, flags=re.S).rstrip() + "\n"
    raio = "14px" if v["barra_estilo"] == "ilha" else "0"
    borda = "1px solid alpha(@fg, 0.08)" if v["barra_estilo"] == "ilha" else "none"
    bloco = (f"\n{MARCA_INI}\nwindow#waybar {{\n    border-radius: {raio};\n    border: {borda};\n}}\n"
             f"#tags button.focused {{\n    background-color: #{v['destaque']};\n"
             f"    border-color: #{v['destaque']};\n}}\n{MARCA_FIM}\n")
    _gravar(WAYBAR_CSS, css + bloco)


# ---------------------------------------------------------------------------
#   temas, papéis de parede e atalhos
# ---------------------------------------------------------------------------

def _pastas_tema(sub):
    return [os.path.join(HOME, "." + sub), os.path.join(HOME, ".local", "share", sub),
            os.path.join("/usr/share", sub)]


def _temas(pastas, exige):
    achados = set()
    for pasta in pastas:
        for d in glob.glob(os.path.join(pasta, "*")):
            if any(os.path.exists(os.path.join(d, e)) for e in exige):
                achados.add(os.path.basename(d))
    return [(n, n) for n in sorted(achados, key=str.lower)]


def temas_gtk():
    return _temas(_pastas_tema("themes"), ["gtk-3.0/gtk.css", "gtk-4.0/gtk.css"])


def temas_icones():
    nomes = []
    for nome, _r in _temas(_pastas_tema("icons"), ["index.theme"]):
        # só cursor (sem ícones de apps): fica para a lista de cursores
        dirs = [d for p in _pastas_tema("icons") for d in glob.glob(os.path.join(p, nome, "*"))
                if os.path.isdir(d)]
        if dirs and all(os.path.basename(d) == "cursors" for d in dirs):
            continue
        nomes.append((nome, nome))
    return nomes


def temas_cursor():
    return _temas(_pastas_tema("icons"), ["cursors"])


def papeis():
    lista = []
    for caminho in sorted(glob.glob(os.path.join(PAPEL_PASTA, "**", "*"), recursive=True)):
        if caminho.lower().endswith(PAPEL_EXT) and os.path.isfile(caminho):
            lista.append((caminho, os.path.relpath(caminho, PAPEL_PASTA)))
    return lista


def atalhos_do_init():
    """Lê os riverctl map / map-pointer do modo normal no init do usuário."""
    txt = _ler(RIVER_INIT) or ""
    atalhos = []
    for linha in txt.splitlines():
        linha = linha.strip()
        m = re.match(r"riverctl\s+map(-pointer)?\s+normal\s+(\S+)\s+(\S+)\s+(.+)$", linha)
        if not m or "$" in m.group(3):
            continue
        mods, tecla, acao = m.group(2), m.group(3), m.group(4).strip()
        try:
            acao = " ".join(shlex.split(acao))
        except ValueError:
            pass
        tecla = {"BTN_LEFT": "botão esquerdo", "BTN_RIGHT": "botão direito",
                 "BTN_MIDDLE": "botão do meio", "Return": "Enter",
                 "Space": "Espaço", "slash": "/", "question": "?"}.get(tecla, tecla)
        combinacao = tecla if mods == "None" else f"{mods}+{tecla}"
        atalhos.append((combinacao, ACOES.get(acao, acao)))
    if re.search(r"set-focused-tags", txt):
        atalhos.append(("Super+1…9", "Ir para a tag (área de trabalho)"))
        atalhos.append(("Super+Shift+1…9", "Mandar a janela para a tag"))
    return atalhos


# ---------------------------------------------------------------------------
#   valores atuais e aplicação
# ---------------------------------------------------------------------------

def river_rodando():
    return bool(os.environ.get("WAYLAND_DISPLAY")) and subprocess.run(
        ["pgrep", "-u", str(os.getuid()), "-x", "river"], stdout=subprocess.DEVNULL).returncode == 0


def valores_atuais():
    v = json.loads(json.dumps(PADRAO))
    salvo = ler_prefs_app().get("valores", {})
    if isinstance(salvo, dict):
        for k in NOMES:
            if k in salvo:
                v[k] = salvo[k]
    # a barra pode ter sido editada à mão: vale o que está no config dela
    barra = waybar_ler()
    for k, val in barra.items():
        if k == "modulos":
            v["modulos"].update(val)
        else:
            v[k] = val
    return v


def gravar_tweaks_sh(v):
    layout, variante, modelo = v["teclado"].split("|")
    linhas = {
        "VOIDBR_KB_LAYOUT": layout,
        "VOIDBR_KB_VARIANT": variante,
        "VOIDBR_KB_MODEL": modelo,
        "VOIDBR_REPEAT_RATE": int(v["repeticao_taxa"]),
        "VOIDBR_REPEAT_DELAY": int(v["repeticao_atraso"]),
        "VOIDBR_TAP": "enabled" if v["toque"] else "disabled",
        "VOIDBR_NATURAL_SCROLL": "enabled" if v["rolagem_natural"] else "disabled",
        "VOIDBR_POINTER_ACCEL": f"{int(v['velocidade']) / 100:.2f}",
        "VOIDBR_FOCUS_FOLLOWS": v["foco"],
        "VOIDBR_ATTACH": v["novas"],
        "VOIDBR_CURSOR": v["cursor"],
        "VOIDBR_CURSOR_SIZE": int(v["cursor_tamanho"]),
        "VOIDBR_BORDER_WIDTH": int(v["borda"]),
        "VOIDBR_ACCENT": v["destaque"],
        "VOIDBR_GAP": int(v["espaco"]),
        "VOIDBR_MAIN_LOCATION": v["area_lugar"],
        "VOIDBR_MAIN_RATIO": f"{int(v['area_proporcao']) / 100:.2f}",
        "VOIDBR_WALL": v["papel"],
        "VOIDBR_WALL_MODE": v["papel_modo"],
        "VOIDBR_LOCK_MIN": int(v["bloquear_min"]),
        "VOIDBR_SCREEN_OFF_MIN": int(v["apagar_min"]),
    }
    texto = ("# Gerado pelo VoidBR River Tweaks - lido pelo voidbr-river-apply\n"
             "# Para voltar ao padrão: VoidBR River Tweaks -> Padrão VoidBR\n")
    texto += "".join(f"{k}={shlex.quote(str(val))}\n" for k, val in linhas.items())
    _gravar(TWEAKS_SH, texto)


def gtk_gravar(v):
    for versao in ("gtk-3.0", "gtk-4.0"):
        caminho = os.path.join(CONFIG, versao, "settings.ini")
        cp = configparser.ConfigParser(interpolation=None)
        cp.optionxform = str
        cp.read(caminho, encoding="utf-8")
        if not cp.has_section("Settings"):
            cp.add_section("Settings")
        cp["Settings"]["gtk-theme-name"] = v["gtk_tema"]
        cp["Settings"]["gtk-icon-theme-name"] = v["icones"]
        cp["Settings"]["gtk-cursor-theme-name"] = v["cursor"]
        cp["Settings"]["gtk-cursor-theme-size"] = str(int(v["cursor_tamanho"]))
        os.makedirs(os.path.dirname(caminho), exist_ok=True)
        with open(caminho, "w", encoding="utf-8") as f:
            cp.write(f, space_around_delimiters=False)
    txt = _ler(FUZZEL_INI)
    if txt is not None:
        if re.search(r"^icon-theme=", txt, flags=re.M):
            txt = re.sub(r"^icon-theme=.*$", f"icon-theme={v['icones']}", txt, flags=re.M)
        else:
            txt = txt.replace("[main]\n", f"[main]\nicon-theme={v['icones']}\n", 1)
        _gravar(FUZZEL_INI, txt)
    if shutil.which("gsettings"):
        base = ["gsettings", "set", "org.gnome.desktop.interface"]
        for chave, val in (("gtk-theme", v["gtk_tema"]), ("icon-theme", v["icones"]),
                           ("cursor-theme", v["cursor"]),
                           ("cursor-size", str(int(v["cursor_tamanho"])))):
            subprocess.run(base + [chave, val], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)


def gtklock_gravar(v):
    txt = _ler(GTKLOCK_CFG) or "[main]\n"
    linhas = [l for l in txt.splitlines() if not re.match(r"\s*(gtk-theme|background)\s*=", l)]
    i = next((n for n, l in enumerate(linhas) if l.strip() == "[main]"), None)
    if i is None:
        linhas.insert(0, "[main]")
        i = 0
    novas = [f"gtk-theme={v['gtk_tema']}"]
    if v["papel_bloqueio"]:
        novas.append(f"background={v['papel']}")
    linhas[i + 1:i + 1] = novas
    _gravar(GTKLOCK_CFG, "\n".join(linhas) + "\n")


def _apply(parte):
    if os.access(APPLY, os.X_OK):
        subprocess.run([APPLY, parte], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


GRUPOS = {
    "barra": ["barra_posicao", "barra_altura", "barra_estilo", "modulos", "destaque"],
    "aparencia": ["gtk_tema", "icones", "cursor", "cursor_tamanho"],
    "river": ["destaque", "borda", "foco", "novas", "teclado", "repeticao_taxa",
              "repeticao_atraso", "toque", "rolagem_natural", "velocidade", "cursor",
              "cursor_tamanho"],
    "layout": ["espaco", "area_lugar", "area_proporcao"],
    "papel": ["papel", "papel_modo"],
    "bloqueio": ["gtk_tema", "papel", "papel_bloqueio"],
    "inatividade": ["bloquear_min", "apagar_min"],
}
NOMES_GRUPO = {"barra": "barra", "aparencia": "tema e ícones", "river": "teclado, mouse e bordas",
               "layout": "janelas", "papel": "papel de parede", "bloqueio": "tela de bloqueio",
               "inatividade": "energia"}


def aplicar(v, antes, progresso=lambda _t: None):
    mudou = {g for g, chaves in GRUPOS.items() if any(v[k] != antes.get(k) for k in chaves)}
    if not mudou:
        return []
    progresso("⏳ Gravando os ajustes…")
    gravar_tweaks_sh(v)
    gravar_prefs_app(valores={k: v[k] for k in NOMES})
    if "barra" in mudou:
        waybar_gravar(v)
    if "aparencia" in mudou:
        gtk_gravar(v)
    if "bloqueio" in mudou:
        gtklock_gravar(v)
    if river_rodando():
        for grupo, parte in (("river", "river"), ("layout", "layout"), ("papel", "papel"),
                             ("inatividade", "inatividade"), ("barra", "barra")):
            if grupo in mudou:
                progresso(f"⏳ Aplicando: {NOMES_GRUPO[grupo]}…")
                _apply(parte)
    return [NOMES_GRUPO[g] for g in GRUPOS if g in mudou]


def _backup(rel, pasta):
    origem = os.path.join(CONFIG, rel)
    if os.path.isfile(origem):
        destino = os.path.join(pasta, ".config", rel)
        os.makedirs(os.path.dirname(destino), exist_ok=True)
        shutil.copy2(origem, destino)


def restaurar(base, progresso=lambda _t: None):
    """base: "voidbr" (skel do VoidBR) ou "river" (exemplo original do River)."""
    agora = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    pasta = os.path.join(HOME, f".voidbr-skel-backup-{agora}")
    progresso(f"⏳ Guardando os arquivos atuais em {pasta}…")
    for rel in ARQ_SKEL:
        _backup(rel, pasta)
    for arq in (TWEAKS_SH, PREFS_APP):
        if os.path.isfile(arq):
            _backup(os.path.relpath(arq, CONFIG), pasta)
            os.remove(arq)
    if base == "voidbr":
        progresso("⏳ Voltando as configurações do VoidBR…")
        for rel in ARQ_SKEL:
            origem = os.path.join(SKEL, rel)
            if os.path.isfile(origem):
                destino = os.path.join(CONFIG, rel)
                os.makedirs(os.path.dirname(destino), exist_ok=True)
                shutil.copy2(origem, destino)
        if river_rodando():
            _apply("tudo")
            return pasta, True
        return pasta, False
    # River original: init de exemplo do pacote river, com o terminal do VoidBR
    txt = _ler(EXEMPLO_RIVER)
    if txt is None:
        raise RuntimeError(f"{EXEMPLO_RIVER} não encontrado (pacote river).")
    txt = txt.replace("spawn foot", "spawn xfce4-terminal")
    _gravar(RIVER_INIT, txt)
    os.chmod(RIVER_INIT, 0o755)
    return pasta, False


# ---------------------------------------------------------------------------
#   interface
# ---------------------------------------------------------------------------

def _escolha(dd, opcoes, valor):
    for i, (v, _r) in enumerate(opcoes):
        if v == valor:
            dd.set_selected(i)
            return
    if valor not in (None, ""):
        # valor que não está na lista (ex.: tema removido): mostra mesmo assim
        opcoes.append((valor, f"{valor} (atual)"))
        dd.get_model().append(f"{valor} (atual)")
        dd.set_selected(len(opcoes) - 1)


class JanelaTweaks(Gtk.ApplicationWindow):
    def __init__(self, app, aba_inicial=None):
        super().__init__(application=app, title="VoidBR River Tweaks")
        self.set_default_size(720, 680)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(self.get_display(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.css_fonte = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(self.get_display(), self.css_fonte,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        try:
            self.escala_fonte = min(ESCALA_MAX, max(ESCALA_MIN,
                                                    float(ler_prefs_app().get("font_scale", 1.0))))
        except (TypeError, ValueError):
            self.escala_fonte = 1.0

        # --- cabeçalho: fonte à esquerda, menu à direita ---
        cab = Gtk.HeaderBar()
        cab.add_css_class("cabecalho-app")
        self.set_titlebar(cab)
        fonte = Gtk.Box()
        fonte.add_css_class("linked")
        self.b_menor = Gtk.Button(label="A−", tooltip_text="Diminuir a fonte (Ctrl -)")
        self.b_escala = Gtk.Button(label="100%", tooltip_text="Tamanho normal (Ctrl 0)")
        self.b_maior = Gtk.Button(label="A+", tooltip_text="Aumentar a fonte (Ctrl +)")
        for b, passo in ((self.b_menor, -1), (self.b_escala, 0), (self.b_maior, 1)):
            b.add_css_class("botao-fonte")
            b.connect("clicked", lambda _b, p=passo: self.mudar_fonte(p))
            fonte.append(b)
        cab.pack_start(fonte)

        menu = Gio.Menu()
        menu.append("📝 Editar o init do River", "win.editar_init")
        menu.append("ℹ️ Sobre / Créditos", "win.sobre")
        bmenu = Gtk.MenuButton(icon_name="open-menu-symbolic")
        bmenu.set_menu_model(menu)
        cab.pack_end(bmenu)
        for nome, cb in (("sobre", self.ao_clicar_sobre),
                         ("editar_init", self.ao_editar_init),
                         ("fonte_mais", lambda *_: self.mudar_fonte(1)),
                         ("fonte_menos", lambda *_: self.mudar_fonte(-1)),
                         ("fonte_normal", lambda *_: self.mudar_fonte(0))):
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", cb)
            self.add_action(acao)
        app.set_accels_for_action("win.fonte_mais", ["<Control>plus", "<Control>equal",
                                                     "<Control>KP_Add"])
        app.set_accels_for_action("win.fonte_menos", ["<Control>minus", "<Control>KP_Subtract"])
        app.set_accels_for_action("win.fonte_normal", ["<Control>0", "<Control>KP_0"])
        self.aplicar_fonte()

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        caixa.add_css_class("conteudo")
        for lado in ("top", "bottom", "start", "end"):
            getattr(caixa, f"set_margin_{lado}")(16)
        self.set_child(caixa)

        titulo = Gtk.Label(label="🛠️ VoidBR River Tweaks", xalign=0)
        titulo.add_css_class("titulo-app")
        caixa.append(titulo)
        sub = Gtk.Label(label="Barra, aparência, janelas, papel de parede, teclado, mouse e energia",
                        xalign=0)
        sub.add_css_class("subtitulo")
        caixa.append(sub)

        self.abas = Gtk.Notebook()
        self.abas.set_vexpand(True)
        self.abas.set_scrollable(True)
        self.indice_aba = {}
        for chave, rotulo, fabrica in (("barra", "🧱 Barra", self._aba_barra),
                                       ("aparencia", "🎨 Aparência", self._aba_aparencia),
                                       ("janelas", "🪟 Janelas", self._aba_janelas),
                                       ("papel", "🖼️ Papel de parede", self._aba_papel),
                                       ("teclado", "⌨️ Teclado, mouse e atalhos", self._aba_teclado),
                                       ("energia", "🔋 Energia", self._aba_energia)):
            rolagem = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            rolagem.set_child(fabrica())
            self.indice_aba[chave] = self.abas.append_page(rolagem, Gtk.Label(label=rotulo))
        caixa.append(self.abas)

        st = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        st.add_css_class("caixa-status")
        self.label_status = Gtk.Label(label="", xalign=0, wrap=True)
        st.append(self.label_status)
        caixa.append(st)

        linha = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        b_river = Gtk.Button(label="🔵 Padrão River",
                             tooltip_text="Volta ao River original: o init de exemplo do pacote "
                                          "river, sem barra, papel de parede nem nada do VoidBR.")
        b_river.add_css_class("botao-azul")
        b_river.connect("clicked", lambda *_: self.confirmar_restaurar("river"))
        b_voidbr = Gtk.Button(label="↩️ Padrão VoidBR",
                              tooltip_text="Volta ao visual VoidBR completo: barra em ilha, "
                                           "cores Tokyo Night, atalhos e papel de parede.")
        b_voidbr.add_css_class("botao-laranja")
        b_voidbr.connect("clicked", lambda *_: self.confirmar_restaurar("voidbr"))
        self.b_restaurar = (b_river, b_voidbr)
        self.b_aplicar = Gtk.Button(label="✅ Aplicar")
        self.b_aplicar.add_css_class("botao-verde")
        self.b_aplicar.connect("clicked", self.ao_clicar_aplicar)
        for b in (b_river, b_voidbr, self.b_aplicar):
            linha.append(b)
        caixa.append(linha)

        self.recarregar()
        if aba_inicial in self.indice_aba:
            self.abas.set_current_page(self.indice_aba[aba_inicial])

    # ----- blocos de interface -----

    def _grade(self, titulo=None):
        g = Gtk.Grid(column_spacing=14, row_spacing=10)
        for lado in ("top", "bottom", "start", "end"):
            getattr(g, f"set_margin_{lado}")(14)
        g._linha = 0
        if titulo:
            self._secao(g, titulo)
        return g

    def _secao(self, g, texto):
        s = Gtk.Label(label=texto, xalign=0)
        s.add_css_class("secao")
        g.attach(s, 0, g._linha, 3, 1)
        g._linha += 1

    def _rotulo(self, g, texto, dica=None):
        r = Gtk.Label(label=texto, xalign=0, hexpand=True)
        r.add_css_class("rotulo-campo")
        g.attach(r, 0, g._linha, 1, 1)
        if dica:
            d = Gtk.Label(label=dica, xalign=0, wrap=True)
            d.add_css_class("dica")
            g.attach(d, 0, g._linha + 1, 3, 1)

    def _avanca(self, g, dica):
        g._linha += 2 if dica else 1

    def _chave(self, g, texto, dica=None):
        self._rotulo(g, texto, dica)
        sw = Gtk.Switch(halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
        g.attach(sw, 1, g._linha, 2, 1)
        self._avanca(g, dica)
        return sw

    def _lista(self, g, texto, opcoes, dica=None):
        self._rotulo(g, texto, dica)
        dd = Gtk.DropDown.new_from_strings([r for _v, r in opcoes])
        dd._opcoes = opcoes
        g.attach(dd, 1, g._linha, 2, 1)
        self._avanca(g, dica)
        return dd

    def _escala(self, g, texto, minimo, maximo, passo=1, sufixo="", dica=None):
        self._rotulo(g, texto, dica)
        esc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, minimo, maximo, passo)
        esc.set_size_request(220, -1)
        esc.set_draw_value(False)
        val = Gtk.Label(xalign=1, width_chars=7)
        esc.connect("value-changed", lambda e: val.set_text(f"{int(e.get_value())}{sufixo}"))
        g.attach(esc, 1, g._linha, 1, 1)
        g.attach(val, 2, g._linha, 1, 1)
        self._avanca(g, dica)
        return esc

    def _aviso(self, g, texto):
        a = Gtk.Label(label=texto, xalign=0, wrap=True)
        a.add_css_class("aviso")
        g.attach(a, 0, g._linha, 3, 1)
        g._linha += 1

    @staticmethod
    def _valor_dd(dd):
        i = dd.get_selected()
        return dd._opcoes[i][0] if 0 <= i < len(dd._opcoes) else None

    # ----- abas -----

    def _aba_barra(self):
        g = self._grade("Barra (Waybar)")
        self.w_barra_estilo = self._lista(g, "Estilo", list(ESTILOS_BARRA),
                                          "Ilha VoidBR: flutua 4 px longe da borda, com cantos "
                                          "arredondados.")
        self.w_barra_posicao = self._lista(g, "Posição na tela", list(POSICOES_BARRA))
        self.w_barra_altura = self._escala(g, "Altura", 28, 56, 2, " px")
        self._secao(g, "Módulos da direita")
        self.w_mod = {}
        for chave, _mods, titulo, dica in MODULOS_BARRA:
            self.w_mod[chave] = self._chave(g, titulo, dica)
        self._aviso(g, "O menu VoidBR, as tags, o relógio e o botão de desligar ficam sempre.")
        return g

    def _aba_aparencia(self):
        g = self._grade("Tema")
        self.op_gtk = temas_gtk()
        self.w_gtk = self._lista(g, "Tema GTK", self.op_gtk,
                                 "Visual dos apps GTK (Firefox, Thunar, este app…) e da tela de "
                                 "bloqueio.")
        self.op_icones = temas_icones()
        self.w_icones = self._lista(g, "Ícones", self.op_icones,
                                    "Ícones dos apps e do lançador (fuzzel).")
        self.op_cursor = temas_cursor()
        self.w_cursor = self._lista(g, "Cursor", self.op_cursor)
        self.w_cursor_tam = self._escala(g, "Tamanho do cursor", 16, 48, 4, " px")
        self._secao(g, "Bordas das janelas")
        self.w_destaque = self._lista(g, "Cor de destaque", list(DESTAQUES),
                                      "Borda da janela em foco e tag atual na barra.")
